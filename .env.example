# ============================================================
# IA GRATIS — sin costo y sin clave obligatoria
# ============================================================
# Por defecto la app usa Pollinations (cuota gratuita, no cobra).
# Texto: https://text.pollinations.ai  |  Imagen: https://image.pollinations.ai
# Investigación de noticias: Google News RSS (gratis, sin clave).
#
# Orden de proveedores a probar (coma). Quita o reordena según quieras.
# Valores válidos: ollama, groq, openrouter, custom, pollinations, gemini
AI_PROVIDERS=ollama,groq,openrouter,pollinations

# --- Pollinations (gratis, sin clave) ---
POLLINATIONS_TEXT_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt
POLLINATIONS_IMAGE_MODEL=sana
# La cuota anónima permite 1 respuesta cada 30 s. La app espera sola.
POLLINATIONS_MIN_INTERVAL_MS=31000
# Opcional: si algún día pides una clave de Pollinations para más cuota
POLLINATIONS_API_KEY=

# --- IA local con Ollama (gratis para siempre, offline) ---
# Instala Ollama y descarga un modelo, por ejemplo:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull qwen2.5:3b
# Si OLLAMA_MODEL está vacío, Ollama se ignora.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Cuotas gratuitas opcionales (solo si quieres más velocidad) ---
# Groq: https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter: https://openrouter.ai/keys  (modelos ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Cualquier API compatible con OpenAI (LM Studio, vLLM, etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Google Gemini (DESACTIVADO por defecto; aquí sí te cobran) ---
# Solo se usa si pones AI_ALLOW_GEMINI=1 y una clave.
AI_ALLOW_GEMINI=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# BÚSQUEDA DE NOTICIAS — Brave / Tavily / Google News (gratis)
# ============================================================
# Orden de proveedores. Si el primero no tiene clave o falla, pasa al siguiente.
# Google News RSS siempre funciona como respaldo sin clave.
SEARCH_PROVIDERS=brave,tavily,google-news

# Brave Search API (free tier ~2,000 consultas/mes): https://api-dashboard.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# Tavily (free tier ~1,000 créditos/mes): https://app.tavily.com/home
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# Filtros por defecto (se pueden sobreescribir por request con "filters")
NEWS_FRESHNESS=week
NEWS_LANGUAGE=es
NEWS_MAX_RESULTS=8
# Dominios preferidos, separados por coma (ej: elfinanciero.com.mx,reuters.com)
NEWS_DOMAINS=

# --- Noticias (Google News RSS, gratis) ---
NEWS_LOCALE=es-419
NEWS_COUNTRY=MX

PORT=3000

# low = respuestas más rápidas; medium/high = más razonamiento (más lento)
POLLINATIONS_REASONING_EFFORT=low

# --- Imágenes (gratis por defecto) ---
# Orden de proveedores de imagen. El primero disponible se usa.
# Valores: pollinations, openrouter, custom
IMAGE_PROVIDERS=pollinations

# Pollinations (gratis, sin clave)
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt
POLLINATIONS_IMAGE_MODEL=sana

# OpenRouter (modelos de imagen gratuitos/pagos): https://openrouter.ai/keys
OPENROUTER_IMAGE_MODEL=

# Endpoint propio compatible OpenAI (LM Studio, Together, etc.)
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1200x900
